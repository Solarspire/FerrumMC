/// Represents a player connected to the Minecraft server.
interface player {
    use common.{hand, position, game-mode, block-pos};
    use item-stack.{item-stack};
    use %world.{%world, entity, ray-trace-block-result, ray-trace-entity-result, equipment-slot};
    use permission.{permission-level};
    use text.{text-component};
    use gui.{gui};
    use java-dialogs.{dialog};
    use java-packets.{clientbound-packet as java-packet};
    use uuid.{uuid};
    use scoreboard.{scoreboard};
    use status-effect.{status-effect-type, status-effect-instance};
    use advancement.{advancement-progress};
    use damage-types.{damage-type};
    use statistics.{statistic-category, custom-statistic};
    use inventory.{inventory, player-inventory};
    use sounds.{sound, sound-category};
    use particles.{particle};
    use entity-statuses.{entity-status};

    /// Represents per-player weather condition overrides.
    enum player-weather {
        clear,
        downfall,
    }

    /// Types of projectiles that can be launched by a player.
    enum projectile-type {
        arrow,
        snowball,
        egg,
        ender-pearl,
        splash-potion,
        fireball,
        small-fireball,
        trident,
        wind-charge,
    }

    /// Types of clientbound game events.
    enum client-game-event {
        no-respawn-block-available,
        begin-raining,
        end-raining,
        change-game-mode,
        win-game,
        demo-event,
        arrow-hit-player,
        rain-level-change,
        thunder-level-change,
        play-pufferfish-string-sound,
        play-elder-guardian-mob-appearance,
        enabled-respawn-screen,
        limited-crafting,
        start-waiting-chunks,
    }

    /// Built-in known server link types displayed in the client Escape pause menu.
    enum known-server-link {
        bug-report,
        community-guidelines,
        support,
        status,
        feedback,
        community,
        website,
        forums,
        news,
        announcements,
    }

    /// Label for a server link: either a built-in standard link type or a custom text component.
    variant server-link-label {
        known(known-server-link),
        custom(text-component),
    }

    /// Represents a server link entry with a label and destination URL.
    record server-link {
        label: server-link-label,
        url: string,
    }

    /// Various abilities a player can have.
    record player-abilities {
        /// Whether the player is invulnerable to damage.
        invulnerable:       bool,
        /// Whether the player is currently flying.
        flying:             bool,
        /// Whether the player is allowed to fly.
        allow-flying:       bool,
        /// Whether the player is in creative mode.
        creative:           bool,
        /// Whether the player can modify the world.
        allow-modify-world: bool,
        /// The speed at which the player flies.
        fly-speed:          f32,
        /// The speed at which the player walks.
        walk-speed:         f32,
    }

    /// Represents a player's skin textures and metadata.
    record player-skin {
        /// The base64-encoded texture data (usually JSON containing skin/cape URLs).
        value: string,
        /// The optional signature for the texture data.
        signature: option<string>,
    }

    /// Represents which skin parts are visible.
    flags skin-parts {
        cape,
        jacket,
        left-sleeve,
        right-sleeve,
        left-pants-leg,
        right-pants-leg,
        hat,
    }



    /// These flags control client-side rendering and behavior.


    /// Represents a specific version of the Minecraft Java Edition protocol.
    enum java-minecraft-version {
        v-1-7-2,
        v-1-7-6,
        v-1-8,
        v-1-9,
        v-1-9-1,
        v-1-9-2,
        v-1-9-3,
        v-1-10,
        v-1-11,
        v-1-11-1,
        v-1-12,
        v-1-12-1,
        v-1-12-2,
        v-1-13,
        v-1-13-1,
        v-1-13-2,
        v-1-14,
        v-1-14-1,
        v-1-14-2,
        v-1-14-3,
        v-1-14-4,
        v-1-15,
        v-1-15-1,
        v-1-15-2,
        v-1-16,
        v-1-16-1,
        v-1-16-2,
        v-1-16-3,
        v-1-16-4,
        v-1-17,
        v-1-17-1,
        v-1-18,
        v-1-18-2,
        v-1-19,
        v-1-19-1,
        v-1-19-3,
        v-1-19-4,
        v-1-20,
        v-1-20-2,
        v-1-20-3,
        v-1-20-5,
        v-1-21,
        v-1-21-2,
        v-1-21-4,
        v-1-21-5,
        v-1-21-6,
        v-1-21-7,
        v-1-21-9,
        v-1-21-11,
        v-26-1,
        v-26-2,
        v-26-3,
        unknown,
    }



    /// Represents settings for a Java Edition player.
    record java-player-settings {
        /// The player's preferred language (e.g., \"en_us\").
        locale: string,
        /// The maximum distance at which chunks are rendered.
        view-distance: u8,
        /// The player's chat visibility settings.
        chat-mode: chat-mode,
        /// Whether chat colors are enabled.
        chat-colors: bool,
        /// The player's skin configuration options.
        skin-parts: skin-parts,
        /// The player's dominant hand (left or right).
        main-hand: hand,
        /// Whether text filtering is enabled.
        text-filtering: bool,
        /// Whether the player wants to appear in the server list.
        server-listing: bool,
    }

    /// The chat visibility settings for a player.
    enum chat-mode {
        /// Chat is fully enabled.
        enabled,
        /// Only system messages and commands are shown.
        commands-only,
        /// Chat is completely hidden.
        hidden,
    }













    /// Policy for tearing down the player's network connection.
    enum socket-teardown-policy {
        /// Send the disconnect packet and gracefully close the connection.
        graceful,
        /// Send the disconnect packet and close the socket immediately.
        immediate-close,
        /// Terminate the connection immediately without sending any disconnect packet.
        drop-connection,
    }

    /// Options for disconnecting a Java Edition player.
    record java-kick-options {
        /// The formatted text component displayed on the Java disconnect screen.
        reason: text-component,
        /// Whether to log the kick in the server console (default: true).
        log-to-console: bool,
        /// How the connection is closed (default: graceful).
        teardown-policy: socket-teardown-policy,
    }



    /// Options for banning a player.
    record ban-player-options {
        /// Ban reason displayed to the player and stored in the ban list.
        reason: option<text-component>,
        /// Source or authority responsible for the ban (default: "Plugin").
        source: option<string>,
        /// Ban expiration in RFC-3339 format, if temporary.
        expires-at-utc: option<string>,
        /// Ban duration in seconds from now, if temporary.
        duration-seconds: option<u64>,
        /// Whether to immediately kick the player if currently online (default: true).
        kick-if-online: bool,
        /// Whether to log the ban action to the server console (default: true).
        log-to-console: bool,
    }

    /// Options for banning an IP address.
    record ban-ip-options {
        /// Ban reason stored in the IP ban list.
        reason: option<text-component>,
        /// Source or authority responsible for the ban (default: "Plugin").
        source: option<string>,
        /// Ban expiration in RFC-3339 format, if temporary.
        expires-at-utc: option<string>,
        /// Ban duration in seconds from now, if temporary.
        duration-seconds: option<u64>,
        /// Whether to immediately kick all online players with this IP (default: true).
        kick-matching-players: bool,
        /// Whether to log the IP ban action to the server console (default: true).
        log-to-console: bool,
    }

    /// A handle to a player on the server.
    resource player {
        /// Returns the player as an entity.
        as-entity: func () -> entity;
        /// Returns the player's unique UUID as a string.
        get-id: func () -> uuid;
        /// Returns the player's username.
        get-name: func () -> string;

        // Basic state

        /// Returns the player's current position in the world.
        get-position: func () -> position;
        /// Returns the player's current yaw (horizontal rotation).
        get-yaw: func () -> f32;
        /// Returns the player's current pitch (vertical rotation).
        get-pitch: func () -> f32;
        /// Returns the world the player is currently in.
        get-world: func () -> %world;
        /// Returns the player's current game mode.
        get-gamemode: func () -> game-mode;
        /// Changes the player's game mode. Returns true if successful.
        set-gamemode: async func (mode: game-mode) -> bool;
        /// Returns the player's locale (e.g., \"en_us\").
        get-locale: func () -> string;
        /// Returns the player's current ping in milliseconds.
        get-ping: func () -> u32;

        // Permissions & metadata

        /// Returns the player's permission level (0-4).
        get-permission-level: func () -> permission-level;
        /// Sets the player's permission level.
        set-permission-level: async func (level: permission-level);
        /// Grants or denies a specific permission node for the player.
        set-permission: func(node: string, value: bool);
        /// Removes an explicitly set permission node from the player.
        unset-permission: func(node: string);
        /// Returns `Some(true)` if granted, `Some(false)` if denied, or `None` if not set.
        has-permission-set: func (node: string) -> option<bool>;
        /// Checks if the player has a specific permission node.
        has-permission: async func (node: string) -> bool;
        /// Returns the player's display name, which may include formatting.
        get-display-name: func () -> text-component;
        /// Sets the player's display name.
        set-display-name: func (display-name: text-component);
        /// Gets the player's custom tab list name.
        get-tab-list-name: func () -> option<text-component>;
        /// Sets the player's custom tab list name.
        set-tab-list-name: func (name: option<text-component>);

        // Messaging, Chat & Commands

        /// Executes a command as this player, checking permissions and returning true if parsed successfully.
        perform-command: async func (command: string) -> bool;
        /// Makes the player send a chat message, or executes a command if it begins with '/'.
        chat: async func (message: string);

        /// Adds custom chat completions to this player's client.
        add-custom-chat-completions: func (completions: list<string>);
        /// Removes custom chat completions from this player's client.
        remove-custom-chat-completions: func (completions: list<string>);
        /// Overwrites all custom chat completions for this player's client.
        set-custom-chat-completions: func (completions: list<string>);

        /// Sends a system message to the player's chat.
        send-system-message: func (text: text-component, overlay: bool);
        /// Deletes a signed chat message from the player's chat window using its 256-byte signature.
        delete-message-by-signature: async func (signature: list<u8>);
        /// Deletes a signed chat message from the player's chat window using its signature cache ID.
        delete-message-by-id: async func (signature-id: s32);
        /// Sets the header and footer of the player's Tab list.
        set-tab-list-header-footer: func (header: text-component, footer: text-component);

        /// Sets the sorting order of the player in the Tab list.
        set-tab-list-order: func (order: s32);
        /// Sets the latency (ping) shown for the player in the Tab list.
        set-tab-list-latency: func (latency: s32);
        /// Sets whether the player is visible in the Tab list.
        set-tab-list-listed: func (listed: bool);

        /// Shows a large title on the player's screen.

        show-title: func (text: text-component);
        /// Shows a smaller subtitle on the player's screen.
        show-subtitle: func (text: text-component);
        /// Shows a message in the action bar area.
        show-actionbar: func (text: text-component);
        /// Sets the fade-in, stay, and fade-out times for titles.
        send-title-animation: func (fade-in: s32, stay: s32, fade-out: s32);

        // Camera & Spectating

        /// Sets the player's camera to view from the perspective of another entity.
        /// If `entity` is `none`, the camera is reset back to the player.
        set-camera: func (entity: option<entity>);
        /// Sets the player's camera to view from the perspective of an entity with the given entity ID.
        /// If `entity-id` is the player's own entity ID, the camera is reset back to the player.
        set-camera-entity-id: func (entity-id: u32);
        /// Gets the entity ID of the entity that the player's camera is currently attached to,
        /// or the player's own entity ID if the camera has not been overridden.
        get-camera-entity-id: func () -> u32;
        /// Resets the player's camera back to their own perspective.
        reset-camera: func ();

        // Audio & Particles

        /// Plays a sound effect for this player at their current location.
        play-sound: func(sound: sound, category: sound-category, volume: f32, pitch: f32);
        /// Plays a sound effect for this player at a specific location.
        play-sound-at: func(pos: position, sound: sound, category: sound-category, volume: f32, pitch: f32);
        /// Stops a sound effect from playing for this player.
        stop-sound: func(sound: option<sound>, category: option<sound-category>);

        /// Plays a custom resource pack sound identifier for this player at their current location.
        play-custom-sound: func(sound-name: string, category: sound-category, volume: f32, pitch: f32);
        /// Plays a custom resource pack sound identifier for this player at a specific location.
        play-custom-sound-at: func(pos: position, sound-name: string, category: sound-category, volume: f32, pitch: f32);
        /// Stops a custom sound identifier from playing for this player.
        stop-custom-sound: func(sound-name: option<string>, category: option<sound-category>);

        /// Spawns particles visible only to this player.
        spawn-particles: func(particle: particle, pos: position, count: u32, offset: position, max-speed: f32);

        // Visuals & Client Overrides

        /// Sends a temporary fake block change to the player's client without modifying the server world.
        send-block-change: func(pos: block-pos, block-id: u16);
        /// Resets a temporary fake block change by resending the actual world block at that position.
        reset-block-change: func(pos: block-pos);

        /// Sends a hurt / damage-tilt animation to the player's client (causes screen shake in the given yaw direction).
        send-hurt-animation: func(yaw: f32);

        /// Sends a visual block break stage (0.0 to 1.0) to this player's client.
        /// Values outside 0.0..1.0 clear the block break overlay.
        send-block-damage: func(pos: block-pos, progress: f32);

        /// Sends a fake equipment change packet to this player for the specified entity.
        send-equipment-change: async func(entity-id: u32, slot: equipment-slot, item: option<item-stack>);

        /// Forces the player's camera to look at the specified target position.
        look-at: func(target: position);

        /// Opens a written book interface for the player from the specified hand.
        open-book: func(hand: hand);
        /// Forces the sign text editor to open for the player at the specified sign block position.
        open-sign-editor: func(pos: block-pos, is-front-text: bool);

        // Velocity & Physics

        /// Sets the player's velocity / motion vector.
        set-velocity: func(velocity: position);
        /// Applies directional knockback impulse to the player.
        apply-knockback: func(strength: f64, x: f64, z: f64);

        /// Returns whether the player is currently sneaking.
        is-sneaking: func() -> bool;
        /// Sets whether the player is sneaking.
        set-sneaking: func(sneaking: bool);

        /// Returns whether the player is currently sprinting.
        is-sprinting: func() -> bool;
        /// Sets whether the player is sprinting.
        set-sprinting: func(sprinting: bool);

        /// Returns whether the player is currently on the ground.
        is-on-ground: func() -> bool;

        /// Returns whether the player is currently sleeping in a bed.
        is-sleeping: func() -> bool;

        /// Returns whether this player is ignored when calculating the percentage of sleeping players needed to skip the night.
        is-sleeping-ignored: func() -> bool;
        /// Sets whether this player is ignored when calculating the percentage of sleeping players needed to skip the night.
        set-sleeping-ignored: func(ignored: bool);

        // Movement Lock & Freezing

        /// Sets whether the player's movement is locked (frozen in place) for cutscenes and NPC dialogues.
        set-movement-locked: func(locked: bool);
        /// Returns whether the player's movement is currently locked.
        is-movement-locked: func() -> bool;

        /// Sets the number of freeze ticks on the player (controlling the powdered snow / frostbite screen vignette).
        set-freeze-ticks: func(ticks: s32);
        /// Returns the current number of freeze ticks on the player.
        get-freeze-ticks: func() -> s32;

        /// Sends custom server links to the player (displayed in the client Esc pause menu in 1.21+).
        set-server-links: func(links: list<server-link>);

        // Teleport & kick

        /// Teleports the player to a position in a world.
        teleport: async func (position: position, yaw: option<f32>, pitch: option<f32>, %world: %world);
        /// Teleports the player to another world at a specific position.
        teleport-world: async func (world-ref: %world, position: position, yaw: option<f32>, pitch: option<f32>);
        /// Forces the player to respawn.
        respawn: async func ();

        /// Opens a GUI for the player.
        open-gui: async func (gui-ref: gui);
        /// Closes the player's currently open container or GUI screen.
        close-inventory: async func ();
        /// Returns whether the player currently has an external container or GUI screen open.
        has-open-inventory: func () -> bool;
        /// Drops the item currently held in the player's main hand into the world.
        /// If `drop-all` is true, drops the entire stack; otherwise drops a single item.
        drop-held-item: async func (drop-all: bool);
        /// Drops the specified item stack from the player's eye position into the world.
        drop-item: async func (item: item-stack);

        /// Bans the player with the specified options.
        ban: async func (options: ban-player-options);
        /// Bans the player's IP address with the specified options.
        ban-ip: async func (options: ban-ip-options);

        /// Transfers the player to another server.
        transfer: async func (host: string, port: u16);

        // Status Effects

        /// Gives a status effect to the player.
        add-effect: async func(effect: status-effect-instance);
        /// Removes a status effect from the player.
        remove-effect: func(effect: status-effect-type);
        /// Clears all active status effects from the player.
        clear-effects: func();
        /// Checks if a status effect is currently applied to the player.
        has-effect: func(effect: status-effect-type) -> bool;
        /// Returns the status effect instance applied to the player, if any.
        get-effect: func(effect: status-effect-type) -> option<status-effect-instance>;
        /// Returns all status effects currently applied to the player.
        get-active-effects: func() -> list<status-effect-instance>;

        // Post Effects (Shaders)

        /// Returns all active post-processing shader effects on this player.
        get-post-effects: func () -> list<string>;
        /// Checks if this player currently has the specified post-processing shader effect.
        has-post-effect: func (effect: string) -> bool;
        /// Adds a post-processing shader effect to this player and syncs it to the client. Returns true if added.
        add-post-effect: async func (effect: string) -> bool;
        /// Removes a post-processing shader effect from this player and syncs it to the client. Returns true if removed.
        remove-post-effect: async func (effect: string) -> bool;
        /// Clears all post-processing shader effects from this player. Returns the number of cleared effects.
        clear-post-effects: async func () -> u32;
        /// Resends the current post-processing shader effects to the client.
        send-post-effects: async func ();

        // Health & Damage

        /// Heals the player by a specified amount.
        heal: async func(amount: f32);
        /// Deals damage to the player by a specified amount with a damage type.
        damage: async func(amount: f32, damage-type: damage-type);
        /// Kills the player instantly.
        kill: async func();

        // Statistics

        /// Gets the value of a statistic for this player in the given category and ID.
        get-statistic: func(category: statistic-category, stat-id: s32) -> s32;
        /// Sets the value of a statistic for this player in the given category and ID.
        set-statistic: func(category: statistic-category, stat-id: s32, value: s32);
        /// Increments the value of a statistic for this player in the given category and ID.
        increment-statistic: func(category: statistic-category, stat-id: s32, amount: s32);

        /// Gets the value of a custom statistic for this player.
        get-custom-statistic: func(stat: custom-statistic) -> s32;
        /// Sets the value of a custom statistic for this player.
        set-custom-statistic: func(stat: custom-statistic, value: s32);
        /// Increments the value of a custom statistic for this player.
        increment-custom-statistic: func(stat: custom-statistic, amount: s32);

        /// Sends the player's updated statistics packet to the client.
        send-stats: func();

        /// Gets the team name that this player belongs to on their active scoreboard, if any.
        get-team: func() -> option<string>;

        // Cooldowns

        /// Starts an item cooldown for a specific item group name.
        start-cooldown: func(group: string, duration-ticks: s32);
        /// Returns the cooldown progress (0.0 to 1.0) for a specific item group.
        get-cooldown: func(group: string) -> f32;
        /// Checks if a specific item group is currently on cooldown.
        is-on-cooldown: func(group: string) -> bool;

        // Abilities & Flight

        /// Sets whether the player is allowed to fly.
        set-allow-flight: func(allowed: bool);
        /// Sets the player's flying speed.
        set-fly-speed: func(speed: f32);
        /// Sets the player's walking speed.
        set-walk-speed: func(speed: f32);
        /// Sets whether the player is invulnerable to damage.
        set-invulnerable: func(invulnerable: bool);

        // Inventory

        /// Returns the player's inventory handle for managing main storage, armor, and equipment.
        get-inventory: func () -> player-inventory;
        /// Returns the player's ender chest inventory handle.
        get-ender-chest: func () -> inventory;

        /// Returns the index of the currently selected hotbar slot (0-8).
        get-selected-slot: func () -> u8;
        /// Returns the item currently in the specified hand.
        get-item-in-hand: func (hand: hand) -> option<item-stack>;
        /// Returns the item in the specified inventory slot.
        get-inventory-item: func (slot: u8) -> option<item-stack>;

        /// Sets the item in the specified hand.
        set-item-in-hand: async func (hand: hand, stack: option<item-stack>);
        /// Sets the item in the specified inventory slot.
        set-inventory-item: async func (slot: u8, stack: option<item-stack>);

        // Ender Chest Inventory

        /// Returns the item in the specified ender chest slot (0-26).
        get-ender-chest-item: func (slot: u8) -> option<item-stack>;
        /// Sets the item in the specified ender chest slot (0-26).
        set-ender-chest-item: async func (slot: u8, stack: option<item-stack>);
        /// Clears all items from the player's ender chest.
        clear-ender-chest: async func ();
        /// Opens the player's ender chest inventory screen for them.
        open-ender-chest: async func ();

        // Status

        /// Returns the player's current health.
        get-health: func () -> f32;
        /// Sets the player's current health.
        set-health: func (health: f32);
        /// Returns the player's maximum health.
        get-max-health: func () -> f32;
        /// Sets the player's maximum health.
        set-max-health: func (max-health: f32);
        /// Returns the player's food level (0-20).
        get-food-level: func () -> u8;
        /// Sets the player's food level.
        set-food-level: async func (food-level: u8);
        /// Returns the player's food saturation level.
        get-saturation: func () -> f32;
        /// Sets the player's food saturation level.
        set-saturation: func (saturation: f32);
        /// Returns the player's food exhaustion level.
        get-exhaustion: func () -> f32;
        /// Sets the player's food exhaustion level.
        set-exhaustion: func (exhaustion: f32);
        /// Returns the player's current absorption amount.
        get-absorption: func () -> f32;
        /// Sets the player's current absorption amount.
        set-absorption: func (absorption: f32);

        /// Returns the player's total experience level.
        get-experience-level:    func() -> s32;
        /// Returns the player's progress toward the next level (0.0 to 1.0).
        get-experience-progress: func() -> f32;
        /// Returns the total experience points the player has.
        get-experience-points:   func() -> s32;
        /// Sets the player's total experience level.
        set-experience-level:    async func(level: s32);
        /// Sets the player's progress toward the next level.
        set-experience-progress: async func(progress: f32);
        /// Sets the player's total experience points.
        set-experience-points:   async func(points: s32);
        /// Adds experience levels to the player.
        add-experience-levels:   async func(levels: s32);
        /// Adds experience points to the player.
        add-experience-points:   async func(points: s32);

        /// Returns whether the player is currently flying.
        is-flying:    func() -> bool;
        /// Sets whether the player should be flying.
        set-flying:   func(flying: bool);

        /// Returns the player's current abilities.
        get-abilities: func() -> player-abilities;
        /// Updates the player's abilities.
        set-abilities: func(abilities: player-abilities);

        /// Returns the player's IP address.
        get-ip: func() -> string;

        /// Returns the player's current skin textures.
        get-skin: func() -> option<player-skin>;

        /// Updates the player's skin textures.
        /// Note: this only updates the fields, it doesn't reload the skin.
        set-skin: func(skin: player-skin);

        /// Returns which skin parts are visible.
        get-skin-parts: func() -> skin-parts;
        /// Sets which skin parts are visible.
        set-skin-parts: func(parts: skin-parts);

        // Per-Player Environment & Overrides

        /// Overrides the time of day shown to this player.
        set-player-time: func(time: u64, relative: bool);
        /// Resets the player's time to sync with the server world time.
        reset-player-time: func();
        /// Returns the custom time set for this player, if any.
        get-player-time: func() -> option<u64>;
        /// Checks if the custom player time is relative to the world time.
        is-player-time-relative: func() -> bool;

        /// Overrides the weather condition shown to this player.
        set-player-weather: func(weather: player-weather);
        /// Resets the player's weather to match the server world weather.
        reset-player-weather: func();
        /// Returns the custom weather set for this player, if any.
        get-player-weather: func() -> option<player-weather>;

        /// Sets the position where the player's compass points.
        set-compass-target: func(pos: position);
        /// Returns the position where the player's compass currently points.
        get-compass-target: func() -> position;

        /// Sets the player's custom respawn / bed location.
        set-respawn-location: func(pos: position);
        /// Returns the player's custom respawn / bed location, if set.
        get-respawn-location: func() -> option<position>;

        /// Hides another player from this player's view (vanish).
        hide-player: func(other: player);
        /// Shows a previously hidden player to this player.
        show-player: func(other: player);
        /// Checks if this player can see another specified player.
        can-see: func(other: player) -> bool;
        /// Checks if this player can see another specified player.
        can-see-player: func(other: player) -> bool;

        /// Sets the tab list ping / latency indicator in milliseconds.
        set-tab-list-ping: func(latency-ms: s32);

        /// Sets a client-side item cooldown overlay.
        set-item-cooldown: func(item-id: string, ticks: s32);
        /// Returns the remaining cooldown ticks for an item, if active.
        get-item-cooldown: func(item-id: string) -> option<s32>;
        /// Checks if an item is currently on cooldown.
        has-item-cooldown: func(item-id: string) -> bool;

        /// Performs a ray-trace from the player's eye position in looking direction to find the targeted block.
        ray-trace-block: func(max-distance: f64, include-fluids: bool) -> option<ray-trace-block-result>;

        /// Performs a ray-trace from the player's eye position in looking direction to find the targeted entity.
        ray-trace-entity: func(max-distance: f64) -> option<ray-trace-entity-result>;

        /// Returns the entity currently targeted in the looking direction within the specified distance.
        get-target-entity: func(max-distance: f64) -> option<entity>;

        /// Raycasts from the player's eyes to find the block being targeted.
        get-target-block: func(max-distance: u32) -> option<position>;

        /// Performs a raycast from the player's eyes to find the exact block and face being targeted.
        get-target-block-exact: func(max-distance: f64, include-fluids: bool) -> option<ray-trace-block-result>;
        /// Launches a projectile from the player's eyes in their line of sight.
        launch-projectile: func(%type: projectile-type) -> option<entity>;

        // Advancements

        /// Returns the progress of the specified advancement for this player, if the advancement exists.
        get-advancement-progress: func(advancement-id: string) -> option<advancement-progress>;

        /// Awards a specific criterion of an advancement to the player.
        /// Returns true if the criterion was successfully awarded (was not already completed).
        award-advancement-criterion: async func(advancement-id: string, criterion: string) -> bool;

        /// Revokes a specific criterion of an advancement from the player.
        /// Returns true if the criterion was successfully revoked (was previously completed).
        revoke-advancement-criterion: func(advancement-id: string, criterion: string) -> bool;

        /// Awards all criteria of the specified advancement to the player.
        /// Returns true if any criterion was newly awarded.
        award-advancement: async func(advancement-id: string) -> bool;

        /// Revokes all criteria of the specified advancement from the player.
        /// Returns true if any criterion was newly revoked.
        revoke-advancement: func(advancement-id: string) -> bool;

        /// Checks whether the player has completed the specified advancement.
        has-advancement: func(advancement-id: string) -> bool;

        /// Returns a list of all advancement IDs completed by this player.
        get-completed-advancements: func() -> list<string>;

        /// Returns the ID of the currently selected advancement tab for this player, if any.
        get-selected-advancement-tab: func() -> option<string>;

        /// Sets the selected advancement tab for this player (must be a root advancement ID).
        set-selected-advancement-tab: func(tab-id: option<string>);

        /// Returns a Java-specific player handle, if the player is connected via Java Edition.
        ///
        /// This allows access to Java-exclusive features like sending specific packets
        /// or retrieving the client brand.
        as-java: func() -> option<java-player>;

        ///
        /// or detailed device information.
    }

    /// Represents a resource pack sent to a Java Edition player.
    record java-resource-pack {
        /// Unique identifier for the resource pack.
        id: uuid,
        /// The URL to the resource pack file.
        url: string,
        /// The SHA1 hash (40-character hex string) of the pack.
        hash: string,
        /// Whether the player is forced to accept the pack.
        forced: bool,
        /// Optional prompt message displayed in the pack acceptance screen.
        prompt-message: option<text-component>,
    }





    /// A handle to a player connected via the Java Edition.
    resource java-player {
        /// Returns the Minecraft Java Edition version of the player.
        get-version: func() -> java-minecraft-version;

        /// Returns the brand of the player's client (e.g., \"vanilla\", \"fabric\").
        get-brand: func() -> string;

        /// Returns the server address the player used to connect.
        get-server-address: func() -> string;

        /// Returns the player's configuration settings.
        get-settings: func() -> java-player-settings;

        /// Sends a Java-specific clientbound packet to the player.
        send-packet: async func(packet: java-packet);

        /// Sends a custom payload packet (plugin message) to the player.
        send-custom-payload: async func(channel: string, data: list<u8>);

        /// Shows a dialog to the player.
        show-dialog: async func(dialog: dialog);

        /// Clears any currently shown dialog for the player.
        clear-dialog: async func();

        /// Returns the Java scoreboard handle for this player.
        get-scoreboard: func() -> scoreboard;

        /// Resets the player's custom Java scoreboard back to the world scoreboard.
        reset-scoreboard: func();

        /// Sends a resource pack to the Java player.
        send-resource-pack: async func(pack: java-resource-pack);

        /// Removes a specific resource pack by UUID for the Java player.
        remove-resource-pack: async func(id: uuid);

        /// Clears all custom resource packs for the Java player.
        clear-resource-packs: async func();

        /// Kicks the Java player with the specified options.
        kick: async func(options: java-kick-options);

        /// Sends a clientbound GameEvent packet to the Java player.
        send-game-event: func(event: client-game-event, value: f32);

        /// Sends an entity status / animation event packet to the Java player for a specific entity ID.
        send-entity-status: func(entity-id: s32, status: entity-status);
    }



    /// Returns a list of all players in a specific world.
    get-world-players: func(world-ref: %world) -> list<player>;
}
